# Sao chép file này thành .env và chỉnh lại cho phù hợp.

# Khóa bí mật để ký JWT — BẮT BUỘC đổi trong môi trường thật.
# Sinh khóa: py -c "import secrets; print(secrets.token_hex(32))"
FINOS_SECRET_KEY=change-me-please-use-a-long-random-string

# Thời gian sống của access token (phút)
FINOS_ACCESS_TOKEN_MINUTES=720

# Đường dẫn file SQLite
FINOS_DB_PATH=finos.db

# Thư mục lưu ảnh gốc đã upload
FINOS_UPLOAD_DIR=uploads

# Giới hạn kích thước ảnh upload (MB) — chặn ảnh quá lớn gây OOM
FINOS_MAX_UPLOAD_MB=12

# Tài khoản admin khởi tạo lần đầu (chỉ dùng khi DB trống)
FINOS_ADMIN_USERNAME=admin
FINOS_ADMIN_PASSWORD=admin123

# Số phút không dùng thì worker giải phóng model OCR khỏi RAM
FINOS_OCR_IDLE_UNLOAD_MINUTES=5
