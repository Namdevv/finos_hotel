# Sao chép thành .env (cùng thư mục docker-compose.yml) trước khi `docker compose up`.
# Sinh khóa bí mật: python -c "import secrets; print(secrets.token_hex(32))"

FINOS_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-that-dai
FINOS_ACCESS_TOKEN_MINUTES=720
FINOS_TIMEZONE=Asia/Ho_Chi_Minh

# Tài khoản admin tạo lần đầu (chỉ khi DB trống). ĐỔI mật khẩu này!
FINOS_ADMIN_USERNAME=admin
FINOS_ADMIN_PASSWORD=doi-mat-khau-nay

# Giới hạn ảnh upload (MB) — gửi ảnh gốc không nén nên để dư.
FINOS_MAX_UPLOAD_MB=25

# --- OCR qua VLM (Ollama) ---
# Ollama chạy trên máy có GPU (cần: ollama pull gemma4:31b-cloud).
# Từ trong container Docker, dùng host.docker.internal để gọi Ollama trên máy chủ.
# Nếu chạy backend trực tiếp (không Docker) thì để http://localhost:11434
FINOS_OLLAMA_HOST=http://host.docker.internal:11434
FINOS_OCR_MODEL=gemma4:31b-cloud
# Ảnh gửi VLM giữ NGUYÊN MẪU (không thu nhỏ). Chỉ xoay đúng chiều:
#   90 = sổ chụp ngang (mặc định). 0 = gửi đúng bytes ảnh gốc, không đụng pixel (chụp thẳng).
FINOS_OCR_ROTATE=90
FINOS_OCR_TIMEOUT_SECONDS=600

# Đường dẫn dữ liệu trong container (khớp volume /data ở docker-compose) — không cần đổi.
FINOS_DB_PATH=/data/finos.db
FINOS_UPLOAD_DIR=/data/uploads
